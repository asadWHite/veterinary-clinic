# PostgreSQL connection string.
# Local default (matches drizzle.config.json):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Canonical site URL — used for metadata, canonical links, sitemap and structured data.
# On Vercel this can stay unset (the app falls back to https://elvet.uz).
SITE_URL=https://elvet.uz

# Optional: initial admin account created by `node scripts/seed.mjs`
SEED_ADMIN_EMAIL=admin@elvet.uz
SEED_ADMIN_PASSWORD=change-me-before-seeding
